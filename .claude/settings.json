{
  "permissions": {
    "deny": ["Read(./.env)"],
    "ask": [
      "Bash(./test.sh:*)",
      "Bash(./deploy.sh:*)",
      "Bash(git push:*)",
      "Bash(docker compose down:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-files.sh" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-file.sh" }]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint-on-stop.sh", "timeout": 180 }
        ]
      }
    ]
  }
}
