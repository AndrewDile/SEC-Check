{
  "name": "sec-check-api",
  "version": "1.0.0",
  "scripts": {
    "test": "vitest run --no-file-parallelism",
    "test:db": "vitest run test/db.test.ts",
    "test:api": "vitest run test/api.test.ts",
    "dev": "tsx watch src/coreapi.ts",
    "build": "tsc",
    "start": "node dist/coreapi.js",
    "lint": "tsc --noEmit && tsc -p test && biome check --formatter-enabled=false .",
    "format": "biome format --write .",
    "lint:fix": "biome check --formatter-enabled=false --write .",
    "format:check": "biome format ."
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "express": "^5.3.0",
    "mysql2": "^3.24.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
