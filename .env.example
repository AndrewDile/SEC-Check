# Copy to .env and fill in. In local development both services can read the same file.

# Where the Core API is, the token these services send it, and the token it sends them
CORE_API_URL=http://localhost:8000
CORE_API_TOKEN=change-me
INBOUND_TOKEN=change-me-too

# Ingestion worker
SEC_USER_AGENT="Team Name contact@example.com"
LOOKBACK_DAYS=30
KEV_POLL_INTERVAL_S=3600
EDGAR_POLL_INTERVAL_S=900

# Notification service
MAX_ATTEMPTS=3

# The worker listens on 127.0.0.1:8002 and the notifier on 127.0.0.1:8001. To change that,
# set HOST and PORT for each service separately, not in a file both of them read.

LOG_LEVEL=INFO

# deploy.sh: SSH target and key for the EC2 instance
DEPLOY_HOST=ec2-user@your-instance.compute.amazonaws.com
DEPLOY_KEY=/path/to/key.pem

# docker compose reads these instead of the two tokens above
DB_ROOT_PASSWORD=change-me
DB_USER=seccheck
DB_PASSWORD=change-me
INGEST_CORE_API_TOKEN=change-me
INGEST_INBOUND_TOKEN=change-me
NOTIF_CORE_API_TOKEN=change-me
NOTIF_INBOUND_TOKEN=change-me
