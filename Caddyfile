# Serves every public service on port 80 (plain HTTP), one path prefix per container.
# handle_path strips the prefix, so /system/health reaches the Core API as /health.
:80 {
	handle_path /system/* {
		reverse_proxy api:3001
	}
	handle_path /tester/* {
		reverse_proxy tester:8100
	}
	# Not handle_path: Dozzle is told its base path, so it expects to receive /logs
	handle /logs* {
		basic_auth {
			{$LOGS_USER} {$LOGS_PASSWORD_HASH}
		}
		reverse_proxy logs:8080
	}
	redir /docs /docs/
	handle_path /docs/* {
		reverse_proxy docs:80
	}
	handle {
		reverse_proxy web_app:8000
	}
}
